{
	"name": "suede",
	"private": true,
	"version": "2026.9.30",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types",
		"db:check": "node scripts/db-check.js",
		"db:push": "node scripts/db-check.js && drizzle-kit push",
		"db:generate": "node scripts/db-check.js && drizzle-kit generate",
		"db:migrate": "node scripts/db-check.js && drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.4.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"storybook": "^10.6.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1",
		"wrangler": "^4.147.0"
	},
	"packageManager": "pnpm@10.6.0+sha512.df0136e797db0cfa7ec1084e77f3bdf81bacbae9066832fbf95cba4c2140ad05e64f316cde51ce3f99ea00a91ffc702d6aedd3c0f450f895e3e7c052fe573cd8",
	"dependencies": {
		"@taurean/stylebase": "^0.11.0",
		"bits-ui": "^2.19.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
